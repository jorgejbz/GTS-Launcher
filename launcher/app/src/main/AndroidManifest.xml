<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Wi-Fi indicator. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Bluetooth on/off and "phone connected" indicator. Read-only: the launcher never connects. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Only requested at runtime if the user picks "GPS (aproximada)" as the speed source. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Vehicle speed from the head unit's CANBUS data service (com.tw.carinfoservice, Topway). -->
    <uses-permission android:name="com.tw.carinfoservice.permission.USE_AIDL" />
    <!-- A launcher must see every app (only matters on Android 11+; the TS10 is Android 10). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Only for the local link to the development PC (diagnostic upload, updates). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates from the PC go through Android's installer, which always asks the user to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GTS">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also listed as a normal app so it can be tried from the stock launcher first. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|fontScale"
            android:exported="false"
            android:label="@string/settings" />

        <activity
            android:name=".AuditActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|fontScale"
            android:exported="false"
            android:label="@string/audit" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- Exists only so Android lets the launcher read the active media sessions (song, controls).
             It ignores every notification. The user has to enable it once in system settings. -->
        <service
            android:name=".MediaAccessService"
            android:exported="true"
            android:label="@string/media_access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
